# deploy/backup.sh's default output location — real database dumps
# contain real business/customer data and must never reach version
# control, even accidentally from a local test run.
/backups/

# Playwright's own run-state scratch file, not a real test artifact.
test-results/

# Uploaded product photos/staff avatars (lib/uploads.ts) — real,
# user-supplied files written to local disk, same reasoning as
# /backups/ above: never belongs in version control.
apps/SureStock-backend/uploads/
