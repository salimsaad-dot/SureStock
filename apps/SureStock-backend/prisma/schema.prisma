// SureStock — backend schema
// Direct translation of "Backend Schema" (Doc 5), targeting whatever
// MySQL-protocol server is actually reachable at DATABASE_URL — in this
// environment that's MariaDB 10.4 (confirmed via `SELECT VERSION()`),
// not vanilla MySQL. Two deliberate departures from the Postgres-authored
// doc, both because the engine has no direct equivalent — see NOTE
// comments at point of use, and the follow-up migration
// 20260818104243_append_only_ledger_and_search for the full story:
//   1. pg_trgm typo-tolerant search  -> plain MariaDB FULLTEXT index.
//      NOT a typo-tolerant substitute — MariaDB has no ngram parser
//      plugin (that's MySQL-8-only). See the migration's comment.
//   2. Postgres partial index        -> plain composite index (table is
//      small enough, <=3,000 SKUs at launch, that the filtered-index win
//      isn't worth losing declarative Prisma support for)
//
// IDs are UUIDv7, generated in application code (apps/api/src/lib/id.ts),
// never as a database default — offline clients must be able to mint an
// id before they've ever reached the server, so the server can't be the
// only thing that knows how.
//
// All DateTime columns are DATETIME(3): MySQL has no timezone-aware
// timestamp type, so the application is responsible for always writing
// and reading UTC. The MySQL server's session time_zone must be set to
// '+00:00' — see apps/api/.env.example.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  // No `url` here — Prisma 7 dropped it from schema.prisma. Migrate's
  // connection lives in prisma.config.ts; the running app's connection
  // is built explicitly in src/lib/prisma.ts via a driver adapter.
}

// ---------------------------------------------------------------------
// Enumerations (Doc 5, §6)
// ---------------------------------------------------------------------

enum MovementReason {
  SALE
  REFUND
  PURCHASE_RECEIVED
  TRANSFER_IN
  TRANSFER_OUT
  DAMAGE
  EXPIRY
  THEFT
  STOCK_TAKE_ADJUSTMENT
  OPENING_BALANCE

  @@map("movement_reason")
}

enum SaleStatus {
  COMPLETED
  REFUNDED
  PARTIALLY_REFUNDED
  VOID

  @@map("sale_status")
}

enum PaymentMethod {
  CASH
  MOBILE_MONEY
  CARD
  ACCOUNT
  CHANGE

  @@map("payment_method")
}

enum PaymentStatus {
  CONFIRMED
  PENDING
  FAILED

  @@map("payment_status")
}

enum ProductStatus {
  ACTIVE
  DISCONTINUED
  SEASONAL

  @@map("product_status")
}

enum UserRole {
  OWNER
  MANAGER
  CASHIER

  @@map("user_role")
}

enum UnitOfMeasure {
  EACH
  KG
  LITRE
  PACK
  METRE

  @@map("unit")
}

enum PurchaseOrderStatus {
  DRAFT
  SENT
  PARTIAL
  RECEIVED
  CANCELLED

  @@map("purchase_order_status")
}

enum StockTakeScope {
  FULL
  CATEGORY

  @@map("stock_take_scope")
}

enum StockTakeStatus {
  IN_PROGRESS
  POSTED
  ABANDONED

  @@map("stock_take_status")
}

// ---------------------------------------------------------------------
// Location & identity
// ---------------------------------------------------------------------

model Location {
  id               String   @id @db.Char(36)
  name             String
  address          String?
  phone            String?
  timezone         String   @default("Africa/Accra")
  receiptHeader    String?  @map("receipt_header") @db.Text
  receiptFooter    String?  @map("receipt_footer") @db.Text
  currency         String   @default("GHS")
  defaultTaxRateId String?  @map("default_tax_rate_id") @db.Char(36)
  createdAt        DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  defaultTaxRate TaxRate?         @relation(fields: [defaultTaxRateId], references: [id])
  users          User[]
  variants       ProductVariant[]
  stockTakes     StockTake[]
  dailySummaries DailySummary[]
  sales          Sale[]

  @@map("location")
}

model User {
  id                String    @id @db.Char(36)
  name              String
  // Nullable unique, same pattern as email below: MySQL allows multiple
  // NULLs under a UNIQUE constraint but enforces uniqueness among
  // non-null values — exactly what's needed since staff log in with
  // whichever of phone/email they actually have, and a login lookup by
  // a non-unique field would be an unresolvable ambiguity, not an edge
  // case to handle later.
  phone             String?   @unique
  email             String?   @unique
  passwordHash      String    @map("password_hash")
  pinHash           String?   @map("pin_hash")
  role              UserRole
  locationId        String    @map("location_id") @db.Char(36)
  isActive          Boolean   @default(true) @map("is_active")
  lastLoginAt       DateTime? @map("last_login_at") @db.DateTime(3)
  // PIN lockout (Doc 6, T-03): 5 failed PIN attempts locks the account
  // for 5 minutes. Tracked in the database, not in memory — a lockout
  // that resets on a server restart isn't a real lockout, and this must
  // hold correctly even with multiple API instances behind a load
  // balancer later.
  failedPinAttempts Int       @default(0) @map("failed_pin_attempts")
  pinLockedUntil    DateTime? @map("pin_locked_until") @db.DateTime(3)
  createdAt         DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.DateTime(3)

  location Location @relation(fields: [locationId], references: [id])

  stockMovements     StockMovement[]
  sales              Sale[]
  tillShifts         TillShift[]
  priceChanges       PriceHistory[]
  auditLogEntries    AuditLog[]
  purchaseOrdersMade PurchaseOrder[]
  stockTakesStarted  StockTake[]

  @@index([locationId])
  @@map("user")
}

// ---------------------------------------------------------------------
// Catalogue
// ---------------------------------------------------------------------

model Category {
  id         String    @id @db.Char(36)
  name       String
  parentId   String?   @map("parent_id") @db.Char(36)
  sortOrder  Int       @default(0) @map("sort_order")
  colour     String?
  archivedAt DateTime? @map("archived_at") @db.DateTime(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.DateTime(3)

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[] @relation("CategoryTree")
  products Product[]

  @@map("category")
}

model Supplier {
  id           String    @id @db.Char(36)
  name         String
  contactName  String?   @map("contact_name")
  phone        String?
  email        String?
  address      String?
  leadTimeDays Int?      @map("lead_time_days")
  paymentTerms String?   @map("payment_terms")
  notes        String?   @db.Text
  archivedAt   DateTime? @map("archived_at") @db.DateTime(3)
  createdAt    DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.DateTime(3)

  products       Product[]
  purchaseOrders PurchaseOrder[]

  @@map("supplier")
}

model TaxRate {
  id          String   @id @db.Char(36)
  name        String
  rate        Decimal  @db.Decimal(5, 4)
  isInclusive Boolean  @default(true) @map("is_inclusive")
  isDefault   Boolean  @default(false) @map("is_default")
  createdAt   DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  products  Product[]
  locations Location[]

  @@map("tax_rate")
}

model Product {
  id           String        @id @db.Char(36)
  name         String
  description  String?       @db.Text
  categoryId   String?       @map("category_id") @db.Char(36)
  supplierId   String?       @map("supplier_id") @db.Char(36)
  unit         UnitOfMeasure @default(EACH)
  taxRateId    String?       @map("tax_rate_id") @db.Char(36)
  isPerishable Boolean       @default(false) @map("is_perishable")
  imageUrl     String?       @map("image_url")
  status       ProductStatus @default(ACTIVE)
  archivedAt   DateTime?     @map("archived_at") @db.DateTime(3)
  createdAt    DateTime      @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt    DateTime      @updatedAt @map("updated_at") @db.DateTime(3)

  // RESTRICT, not the Prisma default: Doc 6 T-05 requires "a category in
  // use cannot be deleted" — silently orphaning products to no category
  // (SET NULL) would satisfy the letter of a delete succeeding while
  // breaking every screen that filters by category. Supplier gets the
  // same treatment for the same reason, and to match purchase_order's
  // existing RESTRICT on supplier_id.
  category Category?        @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  supplier Supplier?        @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  taxRate  TaxRate?         @relation(fields: [taxRateId], references: [id])
  variants ProductVariant[]

  // Correction from an earlier draft of this file: Prisma *does* support
  // FULLTEXT declaratively for MySQL/MariaDB (@@fulltext) — no raw SQL
  // needed here after all. The `map` name matches what the
  // 20260818104243 migration originally created by hand, so this
  // declaration lines up with history instead of fighting it. It is NOT
  // typo-tolerant like pg_trgm was (see that migration's comment) — at
  // <=5,000 rows that's a comfort gap, not a performance one; a plain
  // LIKE '%term%' scan is already sub-150ms at this table size.
  @@fulltext([name], map: "product_name_fulltext")
  @@map("product")
}

model ProductVariant {
  id              String    @id @db.Char(36)
  productId       String    @map("product_id") @db.Char(36)
  sku             String
  barcode         String?   @unique
  variantName     String?   @map("variant_name")
  costPrice       Decimal   @map("cost_price") @db.Decimal(12, 2)
  sellingPrice    Decimal   @map("selling_price") @db.Decimal(12, 2)
  quantityOnHand  Decimal   @default(0) @map("quantity_on_hand") @db.Decimal(12, 3)
  reorderPoint    Decimal?  @map("reorder_point") @db.Decimal(12, 3)
  reorderQuantity Decimal?  @map("reorder_quantity") @db.Decimal(12, 3)
  locationId      String    @map("location_id") @db.Char(36)
  archivedAt      DateTime? @map("archived_at") @db.DateTime(3)
  createdAt       DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.DateTime(3)

  product  Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  location Location @relation(fields: [locationId], references: [id])

  stockMovements     StockMovement[]
  saleLines          SaleLine[]
  batches            Batch[]
  priceHistory       PriceHistory[]
  purchaseOrderLines PurchaseOrderLine[]
  stockTakeLines     StockTakeLine[]

  @@unique([sku, locationId])
  // NOTE: Doc 5 specifies a Postgres *partial* index
  // (WHERE quantity_on_hand <= reorder_point) so the low-stock list stays
  // instant regardless of catalogue size. MySQL has no filtered index;
  // this composite index is the plain substitute. Revisit with a MySQL
  // generated/virtual "is_low_stock" column + index if the catalogue
  // grows well past the ~3,000-SKU launch assumption.
  @@index([locationId, quantityOnHand])
  @@map("product_variant")
}

// ---------------------------------------------------------------------
// The ledger — append-only, everything else reads from here (Doc 5, §2)
// ---------------------------------------------------------------------

model StockMovement {
  id            String         @id @db.Char(36)
  variantId     String         @map("variant_id") @db.Char(36)
  quantityDelta Decimal        @map("quantity_delta") @db.Decimal(12, 3)
  reason        MovementReason
  referenceType String?        @map("reference_type")
  referenceId   String?        @map("reference_id") @db.Char(36)
  unitCost      Decimal?       @map("unit_cost") @db.Decimal(12, 2)
  batchId       String?        @map("batch_id") @db.Char(36)
  note          String?        @db.Text
  userId        String         @map("user_id") @db.Char(36)
  occurredAt    DateTime       @map("occurred_at") @db.DateTime(3)

  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  batch   Batch?         @relation(fields: [batchId], references: [id])
  user    User           @relation(fields: [userId], references: [id])

  // NOTE: Prisma cannot express "REVOKE UPDATE, DELETE" — that guarantee
  // is added as a raw-SQL statement in a follow-up migration, run against
  // the application's runtime DB user only (a separate migration-only
  // user retains full rights). This index is what makes both the
  // reconciliation job and Product detail's movement history fast.
  @@index([variantId, occurredAt(sort: Desc)])
  @@map("stock_movement")
}

model Batch {
  id                String    @id @db.Char(36)
  variantId         String    @map("variant_id") @db.Char(36)
  batchCode         String    @map("batch_code")
  expiryDate        DateTime? @map("expiry_date") @db.Date
  quantityReceived  Decimal   @map("quantity_received") @db.Decimal(12, 3)
  quantityRemaining Decimal   @map("quantity_remaining") @db.Decimal(12, 3)
  unitCost          Decimal   @map("unit_cost") @db.Decimal(12, 2)
  createdAt         DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.DateTime(3)

  variant        ProductVariant  @relation(fields: [variantId], references: [id], onDelete: Restrict)
  stockMovements StockMovement[]

  @@index([variantId, expiryDate])
  @@map("batch")
}

// ---------------------------------------------------------------------
// Sales
// ---------------------------------------------------------------------

model Sale {
  id             String     @id @db.Char(36) // client-generated — doubles as the idempotency key
  receiptNumber  String     @unique @map("receipt_number")
  // Denormalized from tillShift.user.locationId at creation, and never
  // updated afterward — written once in the same transaction as the sale
  // itself, the same pattern as unitPrice/unitCost on SaleLine. This
  // exists purely so location-filtered reporting (dailySummary, Doc 1
  // §3.4) doesn't need a three-table join on every query; it is not a
  // second place location can be edited.
  locationId     String     @map("location_id") @db.Char(36)
  tillShiftId    String     @map("till_shift_id") @db.Char(36)
  userId         String     @map("user_id") @db.Char(36)
  customerId     String?    @map("customer_id") @db.Char(36)
  subtotal       Decimal    @db.Decimal(12, 2)
  discountTotal  Decimal    @default(0) @map("discount_total") @db.Decimal(12, 2)
  taxTotal       Decimal    @map("tax_total") @db.Decimal(12, 2)
  total          Decimal    @db.Decimal(12, 2)
  costTotal      Decimal    @map("cost_total") @db.Decimal(12, 2)
  status         SaleStatus @default(COMPLETED)
  refundOfSaleId String?    @map("refund_of_sale_id") @db.Char(36)
  soldAt         DateTime   @map("sold_at") @db.DateTime(3)
  syncedAt       DateTime?  @map("synced_at") @db.DateTime(3)
  deviceId       String?    @map("device_id")
  createdAt      DateTime   @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt      DateTime   @updatedAt @map("updated_at") @db.DateTime(3)

  location  Location  @relation(fields: [locationId], references: [id])
  tillShift TillShift @relation(fields: [tillShiftId], references: [id])
  user      User      @relation(fields: [userId], references: [id])
  customer  Customer? @relation(fields: [customerId], references: [id])
  refundOf  Sale?     @relation("SaleRefund", fields: [refundOfSaleId], references: [id])
  refunds   Sale[]    @relation("SaleRefund")

  lines    SaleLine[]
  payments Payment[]

  @@index([locationId, soldAt])
  @@index([tillShiftId])
  @@map("sale")
}

model SaleLine {
  id                  String   @id @db.Char(36)
  saleId              String   @map("sale_id") @db.Char(36)
  variantId           String   @map("variant_id") @db.Char(36)
  productNameSnapshot String   @map("product_name_snapshot")
  quantity            Decimal  @db.Decimal(12, 3)
  unitPrice           Decimal  @map("unit_price") @db.Decimal(12, 2)
  unitCost            Decimal  @map("unit_cost") @db.Decimal(12, 2)
  discountAmount      Decimal? @map("discount_amount") @db.Decimal(12, 2)
  discountReason      String?  @map("discount_reason")
  lineTotal           Decimal  @map("line_total") @db.Decimal(12, 2)
  taxAmount           Decimal  @map("tax_amount") @db.Decimal(12, 2)

  sale    Sale           @relation(fields: [saleId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict) // sold products are never deletable

  @@index([variantId])
  @@map("sale_line")
}

model Payment {
  id        String        @id @db.Char(36)
  saleId    String        @map("sale_id") @db.Char(36)
  method    PaymentMethod
  amount    Decimal       @db.Decimal(12, 2)
  reference String? // mobile money transaction id
  provider  String?
  status    PaymentStatus @default(CONFIRMED)
  createdAt DateTime      @default(now()) @map("created_at") @db.DateTime(3)

  sale Sale @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@index([saleId])
  @@map("payment")
}

model TillShift {
  id           String    @id @db.Char(36)
  userId       String    @map("user_id") @db.Char(36)
  openedAt     DateTime  @map("opened_at") @db.DateTime(3)
  openingFloat Decimal   @map("opening_float") @db.Decimal(12, 2)
  closedAt     DateTime? @map("closed_at") @db.DateTime(3)
  expectedCash Decimal?  @map("expected_cash") @db.Decimal(12, 2)
  countedCash  Decimal?  @map("counted_cash") @db.Decimal(12, 2)
  variance     Decimal?  @db.Decimal(12, 2)
  notes        String?   @db.Text

  user  User   @relation(fields: [userId], references: [id])
  sales Sale[]

  @@index([userId, openedAt])
  @@map("till_shift")
}

model Customer {
  id          String   @id @db.Char(36)
  name        String
  phone       String?
  email       String?
  creditLimit Decimal? @map("credit_limit") @db.Decimal(12, 2)
  balance     Decimal  @default(0) @db.Decimal(12, 2)
  notes       String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  sales Sale[]

  @@map("customer")
}

model PriceHistory {
  id        String   @id @db.Char(36)
  variantId String   @map("variant_id") @db.Char(36)
  oldPrice  Decimal  @map("old_price") @db.Decimal(12, 2)
  newPrice  Decimal  @map("new_price") @db.Decimal(12, 2)
  changedBy String   @map("changed_by") @db.Char(36)
  changedAt DateTime @map("changed_at") @db.DateTime(3)
  reason    String?

  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  changer User           @relation(fields: [changedBy], references: [id])

  @@index([variantId, changedAt])
  @@map("price_history")
}

// ---------------------------------------------------------------------
// Purchasing
// ---------------------------------------------------------------------

model PurchaseOrder {
  id           String              @id @db.Char(36)
  supplierId   String              @map("supplier_id") @db.Char(36)
  orderNumber  String              @unique @map("order_number")
  status       PurchaseOrderStatus @default(DRAFT)
  expectedDate DateTime?           @map("expected_date") @db.Date
  totalCost    Decimal?            @map("total_cost") @db.Decimal(12, 2)
  createdBy    String              @map("created_by") @db.Char(36)
  createdAt    DateTime            @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt    DateTime            @updatedAt @map("updated_at") @db.DateTime(3)

  supplier Supplier            @relation(fields: [supplierId], references: [id])
  creator  User                @relation(fields: [createdBy], references: [id])
  lines    PurchaseOrderLine[]

  @@index([supplierId, status])
  @@map("purchase_order")
}

model PurchaseOrderLine {
  id               String  @id @db.Char(36)
  purchaseOrderId  String  @map("purchase_order_id") @db.Char(36)
  variantId        String  @map("variant_id") @db.Char(36)
  quantityOrdered  Decimal @map("quantity_ordered") @db.Decimal(12, 3)
  quantityReceived Decimal @default(0) @map("quantity_received") @db.Decimal(12, 3)
  unitCost         Decimal @map("unit_cost") @db.Decimal(12, 2)

  purchaseOrder PurchaseOrder  @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  variant       ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@index([variantId])
  @@map("purchase_order_line")
}

// ---------------------------------------------------------------------
// Stock takes
// ---------------------------------------------------------------------

model StockTake {
  id         String          @id @db.Char(36)
  locationId String          @map("location_id") @db.Char(36)
  scope      StockTakeScope
  status     StockTakeStatus @default(IN_PROGRESS)
  startedBy  String          @map("started_by") @db.Char(36)
  startedAt  DateTime        @map("started_at") @db.DateTime(3)
  postedAt   DateTime?       @map("posted_at") @db.DateTime(3)

  location Location        @relation(fields: [locationId], references: [id])
  starter  User            @relation(fields: [startedBy], references: [id])
  lines    StockTakeLine[]

  @@index([locationId, status])
  @@map("stock_take")
}

model StockTakeLine {
  id               String   @id @db.Char(36)
  stockTakeId      String   @map("stock_take_id") @db.Char(36)
  variantId        String   @map("variant_id") @db.Char(36)
  expectedQuantity Decimal  @map("expected_quantity") @db.Decimal(12, 3)
  countedQuantity  Decimal? @map("counted_quantity") @db.Decimal(12, 3)
  variance         Decimal? @db.Decimal(12, 3)
  varianceValue    Decimal? @map("variance_value") @db.Decimal(12, 2)
  reason           String?  @db.Text

  stockTake StockTake      @relation(fields: [stockTakeId], references: [id], onDelete: Cascade)
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@index([variantId])
  @@map("stock_take_line")
}

// ---------------------------------------------------------------------
// Cross-cutting: audit trail and reporting rollup
// ---------------------------------------------------------------------

model AuditLog {
  id         String   @id @db.Char(36)
  userId     String?  @map("user_id") @db.Char(36)
  action     String
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id") @db.Char(36)
  before     Json?
  after      Json?
  ip         String?
  deviceId   String?  @map("device_id")
  createdAt  DateTime @default(now()) @map("created_at") @db.DateTime(3)

  user User? @relation(fields: [userId], references: [id])

  @@index([entityType, entityId])
  @@index([userId, createdAt])
  @@map("audit_log")
}

model DailySummary {
  id               String   @id @db.Char(36)
  date             DateTime @db.Date
  locationId       String   @map("location_id") @db.Char(36)
  revenue          Decimal  @db.Decimal(12, 2)
  cogs             Decimal  @db.Decimal(12, 2)
  grossProfit      Decimal  @map("gross_profit") @db.Decimal(12, 2)
  transactionCount Int      @map("transaction_count")
  unitCount        Decimal  @map("unit_count") @db.Decimal(12, 3)
  refundTotal      Decimal  @default(0) @map("refund_total") @db.Decimal(12, 2)
  // Flexible rather than one rigid column per payment method, so adding
  // a new tender type later (e.g. a second mobile money provider) never
  // requires a migration here.
  methodTotals     Json     @map("method_totals")
  createdAt        DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  location Location @relation(fields: [locationId], references: [id])

  @@unique([date, locationId])
  @@map("daily_summary")
}
