# Copy to .env and fill in. Never commit the real .env.

# MySQL 8+. IMPORTANT: the server's session time zone must be UTC —
# every DateTime column is stored naive (see prisma/schema.prisma header),
# so a server not running in UTC will silently corrupt timestamps.
# Confirm with: SELECT @@global.time_zone, @@session.time_zone;
DATABASE_URL="mysql://surestock:REPLACE_WITH_YOUR_PASSWORD@localhost:3306/surestock"

# Used only by `prisma migrate` — needs CREATE DATABASE for its shadow
# database, which the scoped runtime user above deliberately lacks.
# Local dev only; use a dedicated migration user in staging/production —
# see ../../deploy/db-setup.sql for a real least-privilege setup script
# (a separate app user and migrate user, neither of them root).
MIGRATE_DATABASE_URL="mysql://root:@localhost:3306/surestock"

# Separate database so `npm test` never touches dev data. Same scoped
# user as DATABASE_URL, pointed at a different (throwaway) database.
TEST_DATABASE_URL="mysql://surestock:REPLACE_WITH_YOUR_PASSWORD@localhost:3306/surestock_test"

NODE_ENV="development"
PORT="4000"

# Long, random, unique per environment — never reuse across dev/staging/prod.
JWT_SECRET="change-me-to-a-long-random-string"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="30d"

# Only consulted in production (dev/test allow any localhost origin
# automatically — see app.ts's corsOriginResolver). Comma-separated exact
# origins the frontend is actually served from, e.g.
# "https://app.surestock.example". Unset means nothing is allowed —
# fails closed, not open.
# CORS_ORIGIN="https://app.surestock.example"

# Settings -> Notifications (SMS via Africa's Talking). Optional: with
# AFRICASTALKING_API_KEY unset, every notification trigger still runs and
# logs a real NOT_CONFIGURED row (visible in Settings -> Notifications) —
# nothing else to build once a real key is dropped in here.
# Get a free sandbox key at https://account.africastalking.com (username
# "sandbox") to test real delivery without a funded account.
# AFRICASTALKING_API_KEY=""
# AFRICASTALKING_USERNAME="sandbox"
# AFRICASTALKING_SENDER_ID=""
