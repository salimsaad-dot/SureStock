# Copy to .env and fill in. Never commit the real .env.

# MySQL 8+. IMPORTANT: the server's session time zone must be UTC —
# every DateTime column is stored naive (see prisma/schema.prisma header),
# so a server not running in UTC will silently corrupt timestamps.
# Confirm with: SELECT @@global.time_zone, @@session.time_zone;
DATABASE_URL="mysql://surestock:REPLACE_WITH_YOUR_PASSWORD@localhost:3306/surestock"

# Used only by `prisma migrate` — needs CREATE DATABASE for its shadow
# database, which the scoped runtime user above deliberately lacks.
# Local dev only; use a dedicated migration user in staging/production.
MIGRATE_DATABASE_URL="mysql://root:@localhost:3306/surestock"

# Separate database so `npm test` never touches dev data. Same scoped
# user as DATABASE_URL, pointed at a different (throwaway) database.
TEST_DATABASE_URL="mysql://surestock:REPLACE_WITH_YOUR_PASSWORD@localhost:3306/surestock_test"

NODE_ENV="development"
PORT="4000"

# Long, random, unique per environment — never reuse across dev/staging/prod.
JWT_SECRET="change-me-to-a-long-random-string"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="30d"
